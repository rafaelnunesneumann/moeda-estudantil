@startuml 07-cadastrar-vantagem
!theme plain
title US-08 - Cadastrar Vantagem (Empresa Parceira)
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 240
skinparam sequence {
  ArrowColor #D97706
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #D97706
  ParticipantBackgroundColor #FEF3C7
  ActorBorderColor #1E293B
}

actor "Empresa Parceira" as ator
boundary "Portal Empresa\n(Frontend)" as portal
control "VantagemController" as ctrl
participant "VantagemService" as svc
collections "Repositorios JPA" as repo
database "PostgreSQL" as db

ator -> portal : preenche vantagem\n(descricao, foto/URL, custo em moedas)
portal -> ctrl : POST /vantagens\nVantagemRequestDTO (Bearer JWT)
activate ctrl
ctrl -> ctrl : valida papel = EMPRESA (JwtUserDetails)\nempresaId vem do token

break papel diferente de EMPRESA
  ctrl --> portal : 409 Conflict\n("Apenas empresas podem cadastrar vantagens")
end

ctrl -> svc : cadastrar(empresaId, dto)
activate svc

svc -> repo : empresaParceiraRepository.findById(empresaId)
repo -> db : SELECT
db --> repo
repo --> svc : EmpresaParceira

break empresa nao encontrada
  svc --> ctrl : ResourceNotFoundException
  ctrl --> portal : 404 Not Found
end

svc -> svc : cria Vantagem(descricao, foto, custoMoedas, empresa)
svc -> repo : vantagemRepository.save(vantagem)
repo -> db : INSERT INTO VANTAGEM (foto_url, custo_moedas, empresa_id)
db --> repo
repo --> svc : Vantagem persistida

svc --> ctrl : VantagemResponseDTO
deactivate svc
ctrl --> portal : 201 Created
deactivate ctrl
portal --> ator : vantagem cadastrada\n(ja visivel para os alunos - ver 08)
@enduml
